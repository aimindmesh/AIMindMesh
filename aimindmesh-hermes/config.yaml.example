# Hermes Agent Configuration Example for AIMindMesh Ecosystem
# Copy this file to ~/aimindmesh-server/hermes-data/config.yaml on your host VPS
# and customize it.

# =============================================================================
# Model Configuration
# =============================================================================
model:
  # The default model to use (auto handles routing across the FreeLLMAPI pool)
  default: auto

  # Set provider to 'custom' to use the local FreeLLMAPI proxy
  provider: custom

  # Endpoint URL of the local aimindmesh-server proxy route
  base_url: http://aimindmesh-server:3030/api/freellmapi-proxy/v1

  # API key used to authenticate with FreeLLMAPI.
  # Leave as an empty string to automatically fallback to the OPENAI_API_KEY
  # container environment variable passed by docker-compose.
  api_key: ''

# =============================================================================
# Other Configurations
# =============================================================================
# (The rest of the default config.yaml can be generated by running `hermes setup` 
# or left to default fallback values).
