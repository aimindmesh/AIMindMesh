            android:action="android.intent.action.VIEW"
            android:targetPackage="com.aimindmesh.mobile"
            android:targetClass="com.aimindmesh.mobile.MainActivity">
            <extra android:name="route" android:value="call" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="agenda"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_agenda"
        android:shortcutShortLabel="@string/shortcut_agenda_short"
