{
    "name": "vad-capacitor",
    "version": "0.0.1",
    "type": "module",
    "description": "Capacitor plugin for Voice Activity Detection using Silero VAD",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "unpkg": "dist/plugin.js",
    "files": [
        "android/src/main/",
        "android/build.gradle",
        "dist/",
        "src/"
    ],
    "author": "AI Mind Mesh",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aimindmesh/vad-capacitor.git"
    },
    "bugs": {
        "url": "https://github.com/aimindmesh/vad-capacitor/issues"
    },
    "keywords": [
        "capacitor",
        "plugin",
        "native",
        "vad",
        "voice",
        "activity",
        "detection",
        "silero",
        "onnx"
    ],
    "scripts": {
        "verify": "npm run verify:android",
        "verify:android": "cd android && ./gradlew clean build test && cd ..",
        "build": "npm run clean && tsc && rollup -c rollup.config.mjs",
        "clean": "rimraf ./dist",
        "watch": "tsc --watch",
        "prepublishOnly": "npm run build"
    },
    "devDependencies": {
        "@capacitor/android": "^6.0.0",
        "@capacitor/core": "^6.0.0",
        "rimraf": "^5.0.0",
        "rollup": "^4.0.0",
        "typescript": "~5.3.0"
    },
    "peerDependencies": {
        "@capacitor/core": "^6.0.0"
    },
    "capacitor": {
        "android": {
            "src": "android"
        }
    },
    "overrides": {
        "eslint": "^9.26.0",
        "lodash": "4.17.23",
        "lodash-es": "4.17.23",
        "tar": "^7.5.7"
    }
}
