{
    "name": "text-embedding-capacitor",
    "version": "0.0.1",
    "description": "ONNX text embedding plugin for Capacitor (all-MiniLM-L6-v2 compatible)",
    "main": "dist/plugin.cjs.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "unpkg": "dist/plugin.js",
    "files": [
        "android/src/main/",
        "android/build.gradle",
        "dist/",
        "src/"
    ],
    "keywords": [
        "capacitor",
        "plugin",
        "text",
        "embedding",
        "onnx",
        "semantic",
        "memory"
    ],
    "capacitor": {
        "android": {
            "src": "android"
        }
    },
    "scripts": {
        "build": "npm run clean && tsc && rollup -c rollup.config.mjs",
        "clean": "rimraf ./dist",
        "prepublishOnly": "npm run build"
    },
    "devDependencies": {
        "@capacitor/core": "^7.0.0",
        "@rollup/plugin-typescript": "^11.0.0",
        "rimraf": "^6.0.0",
        "rollup": "^4.0.0",
        "tslib": "^2.6.0",
        "typescript": "~5.0.0"
    },
    "peerDependencies": {
        "@capacitor/core": "^7.0.0"
    },
    "overrides": {
        "eslint": "^9.26.0",
        "lodash": "4.17.23",
        "lodash-es": "4.17.23",
        "tar": "^7.5.7"
    }
}
