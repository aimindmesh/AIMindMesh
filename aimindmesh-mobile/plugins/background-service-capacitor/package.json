{
    "name": "background-service-capacitor",
    "version": "0.0.1",
    "type": "module",
    "description": "Capacitor plugin for Android Foreground Service with persistent notifications",
    "main": "dist/plugin.cjs.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "unpkg": "dist/plugin.js",
    "files": [
        "android/src/main/",
        "android/build.gradle",
        "dist/",
        "src/"
    ],
    "author": "AI Mind Mesh",
    "license": "MIT",
    "scripts": {
        "build": "npm run clean && tsc && rollup -c rollup.config.js",
        "clean": "rimraf ./dist",
        "watch": "tsc --watch"
    },
    "devDependencies": {
        "@capacitor/android": "^6.0.0",
        "@capacitor/core": "^6.0.0",
        "rimraf": "^5.0.0",
        "rollup": "^4.0.0",
        "typescript": "~5.3.0"
    },
    "peerDependencies": {
        "@capacitor/core": "^6.0.0"
    },
    "capacitor": {
        "android": {
            "src": "android"
        }
    },
    "overrides": {
        "eslint": "^9.26.0",
        "lodash": "4.17.23",
        "lodash-es": "4.17.23",
        "tar": "^7.5.7"
    }
}
