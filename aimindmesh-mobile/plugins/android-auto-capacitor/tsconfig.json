{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "inlineSources": true,
        "lib": [
            "dom",
            "es2020"
        ],
        "module": "es2020",
        "moduleResolution": "node",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "outDir": "dist/esm",
        "rootDir": "src",
        "sourceMap": true,
        "strict": true,
        "target": "es2020"
    },
    "include": [
        "src"
    ]
}