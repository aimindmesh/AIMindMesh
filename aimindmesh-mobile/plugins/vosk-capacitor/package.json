{
    "name": "vosk-capacitor",
    "version": "0.0.1",
    "type": "module",
    "description": "Capacitor plugin for offline speech recognition using Vosk",
    "main": "dist/plugin.cjs.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "unpkg": "dist/plugin.js",
    "files": [
        "android/src/main/",
        "android/build.gradle",
        "dist/",
        "src/"
    ],
    "author": "AI Mind Mesh",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aimindmesh/vosk-capacitor.git"
    },
    "bugs": {
        "url": "https://github.com/aimindmesh/vosk-capacitor/issues"
    },
    "keywords": [
        "capacitor",
        "plugin",
        "native",
        "vosk",
        "speech",
        "recognition",
        "stt",
        "offline"
    ],
    "scripts": {
        "verify": "npm run verify:android",
        "verify:android": "cd android && ./gradlew clean build test && cd ..",
        "build": "npm run clean && tsc && rollup -c rollup.config.js",
        "clean": "rimraf ./dist",
        "watch": "tsc --watch",
        "prepublishOnly": "npm run build",
        "docgen": "docgen --api VoskPlugin --output-readme README.md --output-json dist/docs.json"
    },
    "devDependencies": {
        "@capacitor/android": "^6.0.0",
        "@capacitor/core": "^6.0.0",
        "@capacitor/docgen": "^0.2.2",
        "@ionic/swiftlint-config": "^1.1.2",
        "rimraf": "^5.0.0",
        "rollup": "^4.0.0",
        "typescript": "~5.3.0"
    },
    "peerDependencies": {
        "@capacitor/core": "^6.0.0"
    },
    "capacitor": {
        "android": {
            "src": "android"
        }
    },
    "overrides": {
        "eslint": "^9.26.0",
        "lodash": "4.17.23",
        "lodash-es": "4.17.23",
        "tar": "^7.5.7"
    }
}
