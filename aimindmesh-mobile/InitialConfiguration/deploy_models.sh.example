#!/bin/bash

# Configuration
REMOTE_HOST="your-vps-ip-or-ddns"
REMOTE_USER="your-user"
REMOTE_PATH="/home/your-user/aimindmesh-server/data/downloads/models"

echo "🚀 Starting model deployment to $REMOTE_HOST..."

# Create remote directory structure
echo "📂 Creating remote directory structure..."
ssh $REMOTE_USER@$REMOTE_HOST "mkdir -p $REMOTE_PATH/GGUF $REMOTE_PATH/LiteRT $REMOTE_PATH/Embedding $REMOTE_PATH/Vosk $REMOTE_PATH/Whisper $REMOTE_PATH/WakeWord $REMOTE_PATH/Piper $REMOTE_PATH/SpeakerID $REMOTE_PATH/VAD"

# Sync files
echo "📤 Syncing models via rsync..."
rsync -avz --progress ./models/ $REMOTE_USER@$REMOTE_HOST:$REMOTE_PATH/

echo "✅ Deployment complete!"
echo "🔗 Files are now available at: http://<VPN_IP>:3030/dl/models/..."
