import fs from 'fs';
import path from 'path';

export interface ServerConfig {
  infrastructureBrake?: boolean;
  server: { port: number; apiKey: string };
  ollama: { 
    baseUrl: string; 
    defaultModel: string; 
    embeddingModel: string; 
    timeoutMs: number;
    numThread: number;
    numCtx: number;
    keepAlive: string; 
  };
  neo4j: { uri: string; user: string; password: string };
  fcm: { serviceAccountPath: string; testToken?: string };
  gemini: { apiKey: string; model: string; dailyQuotaCap: number; rpmLimit?: number; timeoutMs?: number; maxRetries?: number };
  openrouter: { 
    apiKey: string; 
    model: string; 
    dailyQuotaCap: number; 
    timeoutMs?: number;
    creditCheckIntervalHours?: number;
    lowCreditThreshold?: number;
  };
  proactive: {
    enabled: boolean;
    intervalHours: number;
    timezone: string;
    relevanceThreshold: number;
    samplingLimit: number;
    enrichWithWeb?: boolean;
  };
  openclaw?: {
    enabled: boolean;
    gatewayUrl: string;
    defaultSessionKey: string;
    taskTimeoutMs: number;
  };
  hermes?: {
    enabled: boolean;
    gatewayUrl: string;
    apiServerKey: string;
    defaultSessionKey: string;
    taskTimeoutMs: number;
  };
  ingestion: { chunkSize: number; chunkOverlap: number };

  routing: { 
    preferredNode: 'AUTO' | 'LAPTOP' | 'SERVER_LOCAL' | 'GEMINI' | 'OPENROUTER';
    taskPriorities?: Record<string, string[]>;
  };
  logging: { level: 'DEBUG' | 'INFO' | 'WARN' | 'ERROR' };
  auth?: { keys: Record<string, string> };
  debate?: {
    enabled?: boolean;
    mergeEnabled?: boolean;
    mergeIntervalHours?: number;
    participants?: { name: string; persona: string }[];
  };
  delivery: {
    fallbackAfterHours?: number;
    quietHours: boolean;
    quietStart: string;
    quietEnd: string;
  };
  search?: {
    enabled: boolean;
    searxngUrl: string;
    maxResults: number;
  };
  tasks?: {
    retentionLimit?: number;
  };
  wiki?: {
    enabled: boolean;
    storagePath: string;         // default: './data/wiki'
    syncIntervalHours: number;   // default: 24
    gitEnabled: boolean;         // default: false
    maxConceptsPerCycle: number; // default: 20
  };
  autoEvolution?: {
    enabled: boolean;
    cronExpression: string;
    maxProposalsPerDay: number;
    minSeverityThreshold: number;
    minConfidenceThreshold: number;
    requireComplexTier: boolean;
    validationTimeoutMs: number;
    giteaRepoOwner: string;
    giteaRepoName: string;
    giteaDeveloperUsername: string;
    repoLocalPath: string;
    autoMerge: boolean;
    shadowMode?: boolean;
    preferredNode?: string;
    maxFeedbackIterations?: number;     // default: 5
    feedbackAutoTrigger?: boolean;      // default: true
    giteaWebhookSecret?: string;
  };
  kasm?: {
    enabled: boolean;
    baseUrl: string;
    apiKey: string;
    apiKeySecret: string;
    defaultImage: string;
    userId: string;
  };
  freellmapi?: {
    enabled: boolean;
    baseUrl: string;
    apiKey: string;
    timeoutMs: number;
    model: string;
  };
  organization?: {
    enabled: boolean;
    defaultApprovalMode: 'human' | 'auto';
    allowAutoRoleMaterialization: boolean;
    allowAutoRepoCreation: boolean;
    allowAutoKasmValidation: boolean;
    defaultGiteaNamespace: string;
    defaultRepoVisibility: 'public' | 'private' | 'internal';
    searxngBaseUrl: string;
    kasmValidationWorkspaceId: string;
  };
}


const configPath = path.join(__dirname, '../config.json');

export function loadConfig(): ServerConfig {
  const content = fs.readFileSync(configPath, 'utf-8');
  const parsed = JSON.parse(content) as ServerConfig;
  if (parsed.infrastructureBrake === undefined) {
    parsed.infrastructureBrake = false;
  }
  if (!parsed.logging) {
    parsed.logging = { level: 'INFO' };
  }
  if (!parsed.delivery) {
    parsed.delivery = { 
      quietHours: false, 
      quietStart: "23:00", 
      quietEnd: "07:00",
      fallbackAfterHours: 6 
    };
  }
  if (!parsed.search) {
    parsed.search = {
      enabled: false,
      searxngUrl: 'http://your-searxng-ip:8080',
      maxResults: 5
    };
  }
  if (!parsed.tasks) {
    parsed.tasks = {
      retentionLimit: 1000
    };
  }
  if (parsed.ollama) {
    if (parsed.ollama.timeoutMs === undefined) parsed.ollama.timeoutMs = 86400000;
    if (parsed.ollama.numThread === undefined) parsed.ollama.numThread = 6;
    if (parsed.ollama.numCtx === undefined) parsed.ollama.numCtx = 8192;
    if (parsed.ollama.keepAlive === undefined) parsed.ollama.keepAlive = "5m";
  }
  if (!parsed.wiki) {
    parsed.wiki = {
      enabled: true,
      storagePath: './data/wiki',
      syncIntervalHours: 24,
      gitEnabled: false,
      maxConceptsPerCycle: 20
    };
  }
  if (!parsed.openrouter) {
    parsed.openrouter = {
      apiKey: '',
      model: 'anthropic/claude-3.5-sonnet',
      dailyQuotaCap: 100
    };
  } else {
    if (parsed.openrouter.dailyQuotaCap === undefined) parsed.openrouter.dailyQuotaCap = 100;
    if (!parsed.openrouter.model) parsed.openrouter.model = 'anthropic/claude-3.5-sonnet';
    if (!parsed.openrouter.apiKey) parsed.openrouter.apiKey = '';
  }
  if (!parsed.debate) {
    parsed.debate = {
      enabled: true,
      mergeEnabled: true,
      mergeIntervalHours: 12,
      participants: []
    };
  }
  if (!parsed.autoEvolution) {
    parsed.autoEvolution = {
      enabled: false,
      cronExpression: "0 3 * * *",
      maxProposalsPerDay: 3,
      minSeverityThreshold: 6,
      minConfidenceThreshold: 0.65,
      requireComplexTier: true,
      validationTimeoutMs: 60000,
      giteaRepoOwner: "your-username",
      giteaRepoName: "aimindmesh",
      giteaDeveloperUsername: "your-username",
      repoLocalPath: path.join(__dirname, '../../'),
      autoMerge: false,
      shadowMode: false,
      preferredNode: 'AUTO',
      maxFeedbackIterations: 5,
      feedbackAutoTrigger: true
    };
  }

  if (!parsed.kasm) {
    parsed.kasm = {
      enabled: false,
      baseUrl: 'https://your-vps-ip',
      apiKey: '',
      apiKeySecret: '',
      defaultImage: 'kasmweb/ubuntu-focal-desktop:1.15.0',
      userId: ''
    };
  }
  
  if (!parsed.freellmapi) {
    parsed.freellmapi = {
      enabled: false,
      baseUrl: 'http://10.2.0.54:3001',
      apiKey: '',
      timeoutMs: 120000,
      model: 'auto'
    };
  }

  if (!parsed.hermes) {
    parsed.hermes = {
      enabled: false,
      gatewayUrl: 'http://your-hermes-ip:8642',
      apiServerKey: process.env.HERMES_API_KEY || '',
      defaultSessionKey: 'system',
      taskTimeoutMs: 300000
    };
  }

  if (!parsed.organization) {
    parsed.organization = {
      enabled: true,
      defaultApprovalMode: 'human',
      allowAutoRoleMaterialization: false,
      allowAutoRepoCreation: false,
      allowAutoKasmValidation: true,
      defaultGiteaNamespace: 'aimindmesh-labs',
      defaultRepoVisibility: 'private',
      searxngBaseUrl: 'http://searxng:8080',
      kasmValidationWorkspaceId: 'workspace-template-id'
    };
  } else {
    if (parsed.organization.enabled === undefined) parsed.organization.enabled = true;
    if (parsed.organization.defaultApprovalMode === undefined) parsed.organization.defaultApprovalMode = 'human';
    if (parsed.organization.allowAutoRoleMaterialization === undefined) parsed.organization.allowAutoRoleMaterialization = false;
    if (parsed.organization.allowAutoRepoCreation === undefined) parsed.organization.allowAutoRepoCreation = false;
    if (parsed.organization.allowAutoKasmValidation === undefined) parsed.organization.allowAutoKasmValidation = true;
    if (parsed.organization.defaultGiteaNamespace === undefined) parsed.organization.defaultGiteaNamespace = 'aimindmesh-labs';
    if (parsed.organization.defaultRepoVisibility === undefined) parsed.organization.defaultRepoVisibility = 'private';
    if (parsed.organization.searxngBaseUrl === undefined) parsed.organization.searxngBaseUrl = 'http://searxng:8080';
    if (parsed.organization.kasmValidationWorkspaceId === undefined) parsed.organization.kasmValidationWorkspaceId = 'workspace-template-id';
  }

  
  if (parsed.autoEvolution) {
    if (parsed.autoEvolution.maxFeedbackIterations === undefined) parsed.autoEvolution.maxFeedbackIterations = 5;
    if (parsed.autoEvolution.feedbackAutoTrigger === undefined) parsed.autoEvolution.feedbackAutoTrigger = true;
  }

  if (!parsed.routing.taskPriorities) {
    const defaultCloudFirst = ['GEMINI', 'OPENROUTER', 'SERVER_LOCAL'];
    const localFirst = ['SERVER_LOCAL', 'GEMINI', 'OPENROUTER'];
    parsed.routing.taskPriorities = {
      'EVOLUTION': defaultCloudFirst,
      'INTENT_CLASSIFICATION': localFirst,
      'QUERY_EXPANSION': localFirst,
      'CONCEPT_EXTRACTION': localFirst,
      'CONCEPT_ENRICHMENT': localFirst,
      'IMPROVEMENT_DETECTION': localFirst,
      'PROACTIVE_INSIGHT': defaultCloudFirst,
      'DEBATE_PARTICIPATION': defaultCloudFirst,
      'DEBATE_SUMMARY': defaultCloudFirst,
      'INSIGHT_DEDUP': defaultCloudFirst,
      'WIKI_SYNTHESIS': defaultCloudFirst,
      'WIKI_TOPIC_MAP': defaultCloudFirst,
      'CODE_EVOLUTION': defaultCloudFirst,
      'EVOLUTION_VALIDATION': defaultCloudFirst,
      'EMBEDDING_GENERATION': ['SERVER_LOCAL', 'GEMINI', 'OPENROUTER'],
      'GENERAL_CHAT': defaultCloudFirst,
      'WEB_RESEARCH': defaultCloudFirst,
      'AGENTIC_TASK': defaultCloudFirst
    };
  } else {
    // Migration logic for existing configs
    const defaultCloudFirst = ['GEMINI', 'OPENROUTER', 'SERVER_LOCAL'];
    const p = parsed.routing.taskPriorities;
    const migrationMap: Record<string, string[]> = {
      'INTENT_CLASSIFICATION': p['LIGHTWEIGHT'] || defaultCloudFirst,
      'QUERY_EXPANSION': p['LIGHTWEIGHT'] || defaultCloudFirst,
      'CONCEPT_EXTRACTION': p['LIGHTWEIGHT'] || defaultCloudFirst,
      'CONCEPT_ENRICHMENT': p['LIGHTWEIGHT'] || defaultCloudFirst,
      'IMPROVEMENT_DETECTION': p['LIGHTWEIGHT'] || defaultCloudFirst,
      'PROACTIVE_INSIGHT': p['STANDARD'] || defaultCloudFirst,
      'DEBATE_PARTICIPATION': p['STANDARD'] || defaultCloudFirst,
      'DEBATE_SUMMARY': p['STANDARD'] || defaultCloudFirst,
      'INSIGHT_DEDUP': p['STANDARD'] || defaultCloudFirst,
      'WIKI_SYNTHESIS': p['COMPLEX'] || defaultCloudFirst,
      'WIKI_TOPIC_MAP': p['COMPLEX'] || defaultCloudFirst,
      'CODE_EVOLUTION': p['EVOLUTION'] || defaultCloudFirst,
      'EVOLUTION_VALIDATION': p['STANDARD'] || defaultCloudFirst,
      'EMBEDDING_GENERATION': p['EMBEDDING'] || ['SERVER_LOCAL', 'GEMINI', 'OPENROUTER'],
      'GENERAL_CHAT': p['STANDARD'] || defaultCloudFirst,
      'WEB_RESEARCH': p['RESEARCH'] || defaultCloudFirst,
      'AGENTIC_TASK': p['AGENTIC'] || defaultCloudFirst
    };

    for (const [key, value] of Object.entries(migrationMap)) {
      if (!p[key]) p[key] = value;
    }
  }
  
  return parsed;
}

export const config = loadConfig();
