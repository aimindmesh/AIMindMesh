{
  "server": {
    "port": 3030,
    "apiKey": "your-pre-shared-secret"
  },
  "search": {
    "enabled": true,
    "searxngUrl": "http://your-searxng-ip:8080",
    "maxResults": 5
  },
  "ollama": {
    "baseUrl": "http://your-ollama-ip:11434",
    "defaultModel": "gemma4:latest",
    "embeddingModel": "nomic-embed-text",
    "timeoutMs": 86400000,
    "numThread": 6,
    "numCtx": 8192,
    "keepAlive": "-1"
  },
  "neo4j": {
    "uri": "bolt://your-neo4j-ip:7687",
    "user": "neo4j",
    "password": "your-password"
  },
  "fcm": {
    "serviceAccountPath": "./firebase-service-account.json"
  },
  "gemini": {
    "apiKey": "your-gemini-api-key",
    "model": "gemini-1.5-flash",
    "dailyQuotaCap": 450,
    "rpmLimit": 14
  },
  "proactive": {
    "enabled": true,
    "intervalHours": 4,
    "timezone": "UTC",
    "relevanceThreshold": 0.6,
    "samplingLimit": 10
  },
  "ingestion": {
    "chunkSize": 512,
    "chunkOverlap": 64
  },
  "routing": {
    "preferredNode": "AUTO",
    "taskPriorities": {
      "EMBEDDING": ["SERVER_LOCAL", "GEMINI", "OPENROUTER"],
      "LIGHTWEIGHT": ["GEMINI", "OPENROUTER", "SERVER_LOCAL"],
      "STANDARD": ["GEMINI", "OPENROUTER", "SERVER_LOCAL"],
      "COMPLEX": ["GEMINI", "OPENROUTER", "SERVER_LOCAL"],
      "AGENTIC": ["GEMINI", "OPENROUTER", "SERVER_LOCAL"],
      "RESEARCH": ["GEMINI", "OPENROUTER", "SERVER_LOCAL"],
      "EVOLUTION": ["GEMINI", "OPENROUTER", "SERVER_LOCAL"]
    }
  },
  "logging": {
    "level": "INFO"
  },
  "delivery": {
    "quietHours": true,
    "quietStart": "23:00",
    "quietEnd": "07:00",
    "fallbackAfterHours": 6
  },
  "debate": {
    "enabled": true,
    "mergeEnabled": true,
    "mergeIntervalHours": 12,
    "participants": [
      {
        "name": "ADVOCATE",
        "persona": "You are ADVOCATE..."
      },
      {
        "name": "CRITIC",
        "persona": "You are CRITIC..."
      },
      {
        "name": "DEVELOPER",
        "persona": "Senior Full-Stack & AI Developer..."
      }
    ]
  },
  "wiki": {
    "enabled": true,
    "storagePath": "./data/wiki",
    "syncIntervalHours": 24,
    "gitEnabled": false,
    "maxConceptsPerCycle": 20
  },
  "autoEvolution": {
    "enabled": true,
    "cronExpression": "0 3 * * *",
    "maxProposalsPerDay": 3,
    "minSeverityThreshold": 6,
    "minConfidenceThreshold": 0.65,
    "requireComplexTier": false,
    "validationTimeoutMs": 60000,
    "giteaRepoOwner": "your-username",
    "giteaRepoName": "aimindmesh",
    "giteaDeveloperUsername": "your-username",
    "repoLocalPath": "/app",
    "autoMerge": false,
    "shadowMode": false,
    "preferredNode": "OPENROUTER"
  },
  "openrouter": {
    "apiKey": "your-openrouter-api-key",
    "model": "deepseek/deepseek-v3",
    "dailyQuotaCap": 100
  },
  "kasm": {
    "enabled": true,
    "baseUrl": "https://your-kasm-ip:8443",
    "apiKey": "your-kasm-api-key",
    "apiKeySecret": "your-kasm-api-secret",
    "defaultImage": "kasmweb/ubuntu-focal-desktop:1.15.0",
    "userId": "your-user-id"
  },
  "freellmapi": {
    "enabled": false,
    "baseUrl": "http://your-freellmapi-ip:3001",
    "apiKey": "your-freellmapi-key",
    "timeoutMs": 120000,
    "model": "auto"
  },
  "hermes": {
    "enabled": false,
    "gatewayUrl": "http://your-hermes-ip:8642",
    "apiServerKey": "your-hermes-api-key",
    "defaultSessionKey": "system",
    "taskTimeoutMs": 300000
  },
  "organization": {
    "enabled": true,
    "defaultApprovalMode": "human",
    "allowAutoRoleMaterialization": false,
    "allowAutoRepoCreation": false,
    "allowAutoKasmValidation": true,
    "defaultGiteaNamespace": "aimindmesh-labs",
    "defaultRepoVisibility": "private",
    "searxngBaseUrl": "http://searxng:8080",
    "kasmValidationWorkspaceId": "workspace-template-id",
    "autonomousDiscovery": {
      "enabled": true,
      "cronExpression": "0 */12 * * *",
      "maxTopicsPerCycle": 3,
      "minScoreThreshold": 0.55,
      "autoCouncil": false,
      "minAutoCouncilScore": 0.75
    }
  }
}
